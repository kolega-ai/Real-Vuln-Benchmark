{
  "read": {
    "*.env": "allow",
    "*.env.*": "allow"
  },
  "external_directory": {
    "/tmp/*": "allow",
    "/private/tmp/*": "allow",
    "/var/folders/*": "allow"
  },
  "edit": {
    "*": "deny",
    "/tmp/*": "allow",
    "/private/tmp/*": "allow",
    "/var/folders/*": "allow"
  },
  "bash": {
    "rm *": "deny",
    "rmdir *": "deny",
    "mv *": "deny",
    "chmod *": "deny",
    "chown *": "deny",
    "sudo *": "deny",
    "kill *": "deny",
    "killall *": "deny",
    "git push *": "deny",
    "git commit *": "deny",
    "git reset *": "deny",
    "git checkout *": "deny",
    "git clean *": "deny",
    "git stash *": "deny",
    "curl *": "deny",
    "wget *": "deny",
    "npm install *": "deny",
    "npm i *": "deny",
    "npx *": "deny",
    "yarn *": "deny",
    "pnpm *": "deny",
    "pip install *": "deny",
    "pip3 install *": "deny",
    "docker *": "deny"
  },
  "doom_loop": "allow",
  "webfetch": "deny",
  "websearch": "deny"
}
