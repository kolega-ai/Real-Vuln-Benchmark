      "file": "matters/views.py",
      "location": {
        "start_line": 41,
        "end_line": 47,
        "function": "matter_detail"
      },
      "severity": "high",
      "expected_category": "auth",
      "evidence": {
        "source": "manual_review",
        "cve_id": null,
        "description": "Resembles IDOR/BOLA: the view takes a user-supplied 'pk' and loads the object with get_object_or_404(Matter, pk=pk), which a scanner can flag as a user-controlled resource id without an ownership check. It is actually safe because immediately after loading it calls can_access_matter(request.user, matter) and redirects with 'Access denied.' if false. can_access_matter (same file, lines 254-268) enforces firm-admin, lead_attorney==user, paralegal membership, or client-email-to-client.pk scoping. This is the SAFE counterpart to the real api_matter_detail BOLA vuln (api/views.py 42-56) which omits this check."
      },
      "false_positive_trap": true,
      "campaign_id": "v2-campaign-1",
      "provider_run": "kimi-code",
      "app": "legal-case-django"
    },
    {
      "id": "vc-kimi-code-seeded-v2-legal-case-django-fp-003",
      "is_vulnerable": false,
      "vulnerability_class": "sql_injection_false_positive",
      "primary_cwe": "CWE-89",
      "acceptable_cwes": [
