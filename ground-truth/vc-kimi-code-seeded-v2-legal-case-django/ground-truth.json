      ],
      "file": "clients/views.py",
      "location": {
        "start_line": 19,
        "end_line": 24,
        "function": "client_list"
      },
      "severity": "medium",
      "expected_category": "injection",
      "evidence": {
        "source": "manual_review",
        "cve_id": null,
        "description": "Resembles SQL injection: user-controlled GET params (q, status, client_type) are fed straight into database filtering, which keyword scanners flag as a query built from request input. It is actually safe because every filter uses the Django ORM QuerySet API (Client.objects.filter(Q(name__icontains=q) | ...), filter(status=status), filter(client_type=client_type)). The ORM parameterizes all values into bound query parameters; no raw SQL, .raw(), .extra(), or string formatting is used, so the input cannot alter query structure. Access is also gated (clients are blocked at line 12)."
      },
      "false_positive_trap": true,
      "campaign_id": "v2-campaign-1",
      "provider_run": "kimi-code",
