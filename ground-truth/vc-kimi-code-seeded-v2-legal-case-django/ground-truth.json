    },
    {
      "id": "vc-kimi-code-seeded-v2-legal-case-django-fp-004",
      "is_vulnerable": false,
      "vulnerability_class": "path_traversal_false_positive",
      "primary_cwe": "CWE-22",
      "acceptable_cwes": [
        "CWE-22",
        "CWE-20",
        "CWE-73"
      ],
      "file": "documents/views.py",
      "location": {
        "start_line": 124,
        "end_line": 131,
        "function": "document_download"
      },
      "severity": "high",
      "expected_category": "injection",
      "evidence": {
        "source": "manual_review",
        "cve_id": null,
        "description": "Resembles path traversal / arbitrary file read: it computes file_path then open(file_path, 'rb') and reads it back to the client, and sets a Content-Disposition filename via f-string, which scanners flag as user-influenced file access. It is actually safe because file_path = version.file.path is derived from a Django FileField stored on a DocumentVersion row fetched by primary key (get_object_or_404(DocumentVersion, pk=pk)), not from any request-supplied path string; the user controls only an integer pk. Access is gated by can_access_document(request.user, doc) which redirects on failure, and the filename in the header is the stored version.file_name, not a path used for filesystem lookup. No user-controlled path component is concatenated into the open() target. Distinct from the upload-validation vuln at lines 105-108."
      },
      "false_positive_trap": true,
