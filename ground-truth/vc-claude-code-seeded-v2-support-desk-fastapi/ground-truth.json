      },
      "severity": "high",
      "expected_category": "injection",
      "evidence": {
        "source": "manual_review",
        "cve_id": null,
        "description": "Resembles SQL injection: caller-controlled `search` query parameter is interpolated via an f-string (`like = f\"%{search.lower()}%\"`) and passed into a WHERE clause, which scanners pattern-match as user input flowing into a query. It is actually SAFE: the f-string only constructs the LIKE wildcard pattern; the value is then bound through the SQLAlchemy ORM operator `Ticket.subject.ilike(like)`, which sends it as a parameterized bind value, not raw SQL. No string concatenation into raw SQL text occurs, and the input is additionally length-capped (max_length=200) at the route."
      },
      "false_positive_trap": true,
      "campaign_id": "v2-campaign-1",
      "provider_run": "claude-code",
      "app": "support-desk-fastapi"
